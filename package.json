{
  "name": "@devtrack/foundation-api",
  "version": "0.1.0",
  "description": "DevTrack Foundation: core modular NestJS com contratos públicos, composição por perfil e módulos nativos.",
  "author": "",
  "license": "MIT",
  "bin": {
    "devtrack-check-publishable": "scripts/check-publishable.mjs"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "node --test scripts/check-boundaries.test.mjs",
    "compose": "ts-node --transpile-only scripts/generate-composition.ts",
    "prebuild": "npm run check:boundaries && npm run compose -- --check",
    "lint:check": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:contracts": "npm run build && node --test test/contracts/public-entrypoint.test.cjs",
    "build:artifact": "ts-node --transpile-only scripts/build-artifact.ts",
    "test:artifact": "node --require ts-node/register/transpile-only --test scripts/build-artifact.test.ts",
    "conformance": "node --require ts-node/register/transpile-only tooling/module-conformance/runner/cli.ts",
    "test:conformance": "node --require ts-node/register/transpile-only --test tooling/module-conformance/test/kit.test.ts tooling/module-conformance/test/qualify-published.test.ts",
    "conformance:published": "node --require ts-node/register/transpile-only tooling/module-conformance/runner/qualify-published.ts",
    "check:publishable": "node scripts/check-publishable.mjs",
    "test:publishable": "node --test scripts/check-publishable.test.mjs",
    "prepack": "node scripts/check-publishable.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "bullmq": "6.7.2",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "1.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "12.2.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./nest": {
      "types": "./dist/core/infrastructure/modules/foundation-core.module.d.ts",
      "default": "./dist/core/infrastructure/modules/foundation-core.module.js"
    },
    "./native/opentelemetry": {
      "types": "./dist/native/opentelemetry/index.d.ts",
      "default": "./dist/native/opentelemetry/index.js"
    },
    "./native/persistence-typeorm": {
      "types": "./dist/native/persistence-typeorm/index.d.ts",
      "default": "./dist/native/persistence-typeorm/index.js"
    },
    "./native/aws-s3": {
      "types": "./dist/native/aws-s3/index.d.ts",
      "default": "./dist/native/aws-s3/index.js"
    },
    "./native/cache-redis": {
      "types": "./dist/native/cache-redis/index.d.ts",
      "default": "./dist/native/cache-redis/index.js"
    },
    "./native/queue-bullmq": {
      "types": "./dist/native/queue-bullmq/index.d.ts",
      "default": "./dist/native/queue-bullmq/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "scripts/check-publishable.mjs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
